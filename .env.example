# Banking Systems Assurance Platform — example environment file.
# Copy to .env and fill in real values for your local environment.
# NEVER commit a real .env file. This file contains placeholders only.

# --- Application --------------------------------------------------------
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=local

# --- Local-first / external-provider kill switches -----------------------
# Do not change these to enable external providers without an explicit,
# reviewed decision — see BANKING_PLATFORM_INTEGRATION_PLAN.md §7.
LOCAL_ONLY_MODE=true
EXTERNAL_PROVIDERS_ENABLED=false

OPENAI_ENABLED=false
GEMINI_ENABLED=false
CLAUDE_ENABLED=false

# Leave empty. Only set if a provider is explicitly approved and enabled.
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# --- Vector backend --------------------------------------------------------
# One of: pgvector | chroma
VECTOR_BACKEND=pgvector
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=banking_assurance_chunks

# --- PostgreSQL / pgvector ---------------------------------------------------
# No default is provided anywhere in this platform — you must set a real,
# non-placeholder credential. Replace CHANGE_ME before use.
# Optional local developer mode URL (host -> container db mapping is 5434:5432).
# Docker Compose app service ignores this value and uses db:5432 internally.
DATABASE_URL=postgresql://banking_assurance:CHANGE_ME@localhost:5434/banking_assurance_db

# --- Local embeddings -----------------------------------------------------------
EMBEDDING_PROVIDER=local

# --- Retention foundations (identify-only — never deletes anything) ------------------
# DATA_RETENTION_DAYS=

# --- Optional external-agent boundary (agents/, Phase 6) ------------------------------
# AGENT_ENABLED is separate from EXTERNAL_PROVIDERS_ENABLED above: turning this on
# still only ever unlocks *local* agent mode unless every condition documented in
# docs/agent_guide.md also holds. No real outbound provider call is implemented in
# this codebase — see providers/README.md.
AGENT_ENABLED=false
AGENT_PROVIDER=local             # local | openai | gemini | claude
AGENT_MODEL_NAME=
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=1
AGENT_MAX_CONTEXT_CHARS=4000
AGENT_MAX_EVIDENCE_ITEMS=5

# --- Scanning boundary (fail-closed if empty) --------------------------------------
# Comma-separated list of absolute paths the scanner is allowed to read.
# Optional local developer mode value (outside Docker).
ALLOWED_SCAN_PATHS=mock_banking_system,reference_banking_system

# Docker app container scan paths (inside container filesystem).
# Default read-only mounts in deployment/docker-compose.yml:
#   ../mock_banking_system:/scan-targets/mock_banking_system:ro
#   ../reference_banking_system:/scan-targets/reference_banking_system:ro
DOCKER_ALLOWED_SCAN_PATHS=/scan-targets/mock_banking_system,/scan-targets/reference_banking_system
MAX_SCAN_FILE_SIZE_BYTES=1048576

# --- Storage paths ------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=data/documents
REPORT_OUTPUT_DIR=data/reports

# --- Docker Compose (deployment/docker-compose.yml) ----------------------------------
POSTGRES_USER=banking_assurance
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=banking_assurance_db
