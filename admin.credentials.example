# Template for a local administrator credentials file.
#
#   1. Copy to `admin.credentials` (that exact name is git-ignored and
#      docker-ignored — it never enters the repository or the image).
#   2. Set a strong password: at least 12 characters, not containing the
#      username.
#   3. Create the account (stored only as a salted scrypt hash):
#        docker compose -f deployment/docker-compose.yml exec -T app python -m scripts.create_admin --credentials-file - < admin.credentials
#      or, outside Docker:
#        python -m scripts.create_admin --credentials-file admin.credentials
#
# Re-running is safe: an existing account is left unchanged. The platform
# never reads this file on its own; delete it once the account exists if
# you do not want the password kept on disk.

ADMIN_USERNAME=your.username
ADMIN_DISPLAY_NAME=Your Name
ADMIN_PASSWORD=replace-with-a-long-unique-passphrase
